%% CAREERSIM TARGET AI AGENT DOMAIN MODEL — REQUIREMENTS BASELINE v1.2 (2026-10-19)
%% MVP: Student Agent + Admin Builder/KB Studio; RAG A, real tool calling B, structured output C.
%% No Student chat-file upload, Enterprise Agent, generic write proposals, Agent-to-Agent review,
%% or advanced cross-session learning in the MVP; keep future extensibility, NOT phantom entities.
%% No Service/Controller/DTO/DAO/tool implementation class, no relationship-word labels.
namespace IdentityAndConsent {
    class UserAccount {
        -id: UUID
        -role: AccountRole
    }
    class ConsentGrant {
        -id: UUID
        -userId: UUID
        -purpose: ConsentPurpose
        -status: ConsentStatus
        -policyVersion: String
        -expiresAt: Instant
        +isEffective(): boolean
        +revoke(): void
    }
}
namespace AgentRegistryAndAccess {
    class Agent {
        -id: UUID
        -name: String
        -purpose: String
        -status: AgentStatus
        -allowedRoles: Set~AccountRole~
        -publishedConfigurationId: UUID
        +isAssignable(): boolean
    }
    class AgentConfiguration {
        -id: UUID
        -versionNumber: int
        -modelKey: String
        -promptTemplate: String
        -toolPolicy: JsonNode
        -memoryPolicy: JsonNode
        -status: ConfigStatus
        -publishedAt: Instant
        +allowsTool(code): boolean
    }
    class AgentAssignment {
        -id: UUID
        -studentUserId: UUID
        -agentId: UUID
        -assignedByAdminUserId: UUID
        -status: AssignmentStatus
        -assignedAt: Instant
        -revokedAt: Instant
        +isEffective(): boolean
    }
}
namespace ChatAndExecution {
    class AgentSession {
        -id: UUID
        -ownerUserId: UUID
        -agentId: UUID
        -configurationId: UUID
        -title: String
        -status: SessionStatus
        -contextSummary: JsonNode
        -summarySourceRefs: JsonNode
        -summaryStatus: SummaryStatus
        -summaryUpdatedAt: Instant
        -startedAt: Instant
        -deletedAt: Instant
        +deleteHistory(): void
    }
    class InteractionRecord {
        -id: UUID
        -sequenceNumber: int
        -actorType: InteractionActor
        -promptOrContent: JsonNode
        -createdAt: Instant
    }
    class AgentExecution {
        -id: UUID
        -configurationId: UUID
        -sessionId: UUID
        -inputInteractionId: UUID
        -knowledgeBaseId: UUID
        -inputSnapshot: JsonNode
        -taskType: AgentTaskType
        -executionMode: ExecutionMode
        -initiatedByUserId: UUID
        -toolStepsAndSources: JsonNode
        -outputSnapshot: JsonNode
        -status: ExecutionStatus
        -refusalOrErrorCode: String
        -inputTokens: long
        -outputTokens: long
        -estimatedCost: Decimal
        -latencyMs: long
        -startedAt: Instant
        -finishedAt: Instant
    }
    class InsightReport {
        -id: UUID
        -ownerUserId: UUID
        -requestedInteractionId: UUID
        -sourceExecutionId: UUID
        -schemaVersion: String
        -structuredInsights: JsonNode
        -evidenceRefs: JsonNode
        -status: ReportStatus
        -createdAt: Instant
    }
    class ExplorationPlan {
        -id: UUID
        -ownerUserId: UUID
        -sourceExecutionId: UUID
        -planData: JsonNode
        -confirmedAt: Instant
    }
}
namespace AdminKnowledgeAndRAG {
    class KnowledgeBase {
        -id: UUID
        -name: String
        -scopeType: KnowledgeScopeType
        -enterpriseId: UUID
        -visibility: KnowledgeVisibility
        -status: KnowledgeBaseStatus
        +isRetrievable(): boolean
    }
    class KnowledgeAsset {
        -id: UUID
        -knowledgeBaseId: UUID
        -assetKey: String
        -title: String
        -sourceFileId: UUID
        -sourceUri: String
        -mimeType: String
        -uploadedByAdminUserId: UUID
        -versionNumber: int
        -contentHash: String
        -ingestionStatus: IngestionStatus
        -publicationStatus: PublicationStatus
        -publishedAt: Instant
    }
    class KnowledgeChunk {
        -id: UUID
        -sourceAssetId: UUID
        -chunkIndex: int
        -contentText: String
        -sourceLocation: String
        -embeddingRef: String
    }
}
