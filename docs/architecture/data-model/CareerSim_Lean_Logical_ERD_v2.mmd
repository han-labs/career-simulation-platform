    USER_ACCOUNT {
        uuid id PK
        string email UK
        string passwordHash
        string displayName
        string role
        string status
        timestamp createdAt
    }

    STUDENT_PROFILE {
        uuid id PK
        uuid userId FK,UK
        string institution
        string careerGoal
    }

    ENTERPRISE {
        uuid id PK
        string name
        string verificationStatus
        string publishingStatus
    }

    ENTERPRISE_REPRESENTATIVE {
        uuid id PK
        uuid userId FK,UK
        uuid enterpriseId FK
        string membershipStatus
        boolean publishingPermission
    }

    CONSENT_GRANT {
        uuid id PK
        uuid studentId FK
        uuid enterpriseId FK
        string purpose
        string status
        string policyVersion
        timestamp updatedAt
    }

    AUDIT_LOG {
        uuid id PK
        uuid actorUserId FK
        string action
        string targetType
        uuid targetId
        jsonb detail
        timestamp occurredAt
    }

    ASSESSMENT_TYPE {
        uuid id PK
        string code UK
        string name
        uuid activeVersionId FK
    }

    ASSESSMENT_VERSION {
        uuid id PK
        uuid assessmentTypeId FK
        int versionNumber
        string status
        string evaluatorKey
        jsonb scoringConfig
    }

    ASSESSMENT_QUESTION {
        uuid id PK
        uuid assessmentVersionId FK
        int position
        string prompt
        string responseType
        jsonb responseConfig
    }

    ASSESSMENT_ATTEMPT {
        uuid id PK
        uuid studentId FK
        uuid assessmentVersionId FK
        string status
        timestamp startedAt
        timestamp submittedAt
    }

    ASSESSMENT_RESPONSE {
        uuid id PK
        uuid attemptId FK
        uuid questionId FK
        uuid assessmentVersionId FK
        jsonb answerData
    }

    ASSESSMENT_RESULT {
        uuid id PK
        uuid attemptId FK,UK
        jsonb resultData
        string interpretation
        timestamp calculatedAt
    }

    SCENARIO {
        uuid id PK
        uuid enterpriseId FK
        uuid currentVersionId FK
        string availabilityStatus
    }

    SCENARIO_VERSION {
        uuid id PK
        uuid scenarioId FK
        int versionNumber
        string status
        string title
        string targetRole
        text introduction
        timestamp publishedAt
    }

    SIMULATION_TASK {
        uuid id PK
        uuid scenarioVersionId FK
        int position
        string title
        text instructions
        boolean required
    }

    TASK_DELIVERABLE_DEFINITION {
        uuid id PK
        uuid taskId FK
        int position
        string name
        string format
        boolean required
        jsonb validationConfig
    }

    TASK_RESOURCE {
        uuid id PK
        uuid taskId FK
        uuid fileAssetId FK
        string title
        string resourceType
        string externalUrl
    }

    MODEL_ANSWER {
        uuid id PK
        uuid taskId FK,UK
        text content
        string releasePolicy
        jsonb attachmentRefs
    }

    SIMULATION_ENROLLMENT {
        uuid id PK
        uuid studentId FK
        uuid scenarioVersionId FK
        string status
        timestamp enrolledAt
    }

    TASK_SUBMISSION {
        uuid id PK
        uuid enrollmentId FK
        uuid taskId FK
        uuid scenarioVersionId FK
        string status
        uuid idempotencyKey
        timestamp submittedAt
    }

    SUBMITTED_DELIVERABLE {
        uuid id PK
        uuid submissionId FK
        uuid definitionId FK
        uuid taskId FK
        text contentText
        string contentUrl
        uuid fileAssetId FK
    }

    SIMULATION_COMPLETION {
        uuid id PK
        uuid enrollmentId FK,UK
        timestamp completedAt
        text resumeSnippetText
        string snippetTemplateVersion
        string certificateCode
        jsonb certificateSnapshot
        timestamp certificateIssuedAt
    }

    CAREER_SKILL {
        uuid id PK
        string code UK
        string name
    }

    TASK_SKILL {
        uuid taskId PK,FK
        uuid skillId PK,FK
    }

    FILE_ASSET {
        uuid id PK
        string storageKey UK
        string originalName
        string mimeType
        long sizeBytes
        string checksum
    }

    AGENT {
        uuid id PK
        string code UK
        string name
        string status
        jsonb allowedRoles
    }

    AGENT_CONFIGURATION {
        uuid id PK
        uuid agentId FK
        int versionNumber
        string status
        string modelKey
        text instructions
        jsonb enabledTools
        jsonb executionLimits
    }

    AGENT_CONFIGURATION_KB {
        uuid configurationId PK,FK
        uuid knowledgeBaseId PK,FK
    }

    KNOWLEDGE_BASE {
        uuid id PK
        string name
        string visibility
        string status
    }

    KNOWLEDGE_DOCUMENT {
        uuid id PK
        uuid knowledgeBaseId FK
        string title
        string sourceType
    }

    KNOWLEDGE_DOCUMENT_VERSION {
        uuid id PK
        uuid documentId FK
        uuid fileAssetId FK
        int versionNumber
        string contentHash
        string ingestionStatus
        string reviewStatus
    }

    KNOWLEDGE_CHUNK {
        uuid id PK
        uuid documentVersionId FK
        int chunkIndex
        text contentText
        jsonb sourceLocation
        vector embedding
    }

    AGENT_CONVERSATION {
        uuid id PK
        uuid ownerUserId FK
        uuid agentId FK
        uuid configurationId FK
        string title
        string status
        timestamp createdAt
    }

    AGENT_MESSAGE {
        uuid id PK
        uuid conversationId FK
        int sequenceNumber
        string role
        text content
        timestamp createdAt
    }

    AGENT_RUN {
        uuid id PK
        uuid actorUserId FK
        uuid conversationId FK
        uuid configurationId FK
        uuid consentGrantId FK
        string mode
        string status
        jsonb stepsTrace
        jsonb sourceReferences
        timestamp startedAt
    }

    AGENT_MEMORY {
        uuid id PK
        uuid ownerUserId FK
        uuid agentId FK
        uuid enterpriseContextId FK
        text summary
        string status
        timestamp expiresAt
    }

    AGENT_ACTION_PROPOSAL {
        uuid id PK
        uuid runId FK
        uuid requestedByUserId FK
        string targetType
        jsonb payload
        string payloadHash
        string status
        timestamp approvedAt
    }

    EXPLORATION_PLAN {
        uuid id PK
        uuid studentId FK
        uuid proposalId FK
        jsonb planData
        timestamp confirmedAt
    }

