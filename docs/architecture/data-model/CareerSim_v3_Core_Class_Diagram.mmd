classDiagram
direction LR
%% CareerSim v3  |  Core Domain & Learning
%% Target domain/application view; multiplicities on ends, no association labels.
%% Only meaningful responsibilities are shown.
namespace Identity {
    class UserAccount {
        -id: UUID
        -email: String
        -role: AccountRole
        -status: AccountStatus
        +isActive(): boolean
    }
    class StudentProfile {
        -id: UUID
        -major: String
        -institution: String
        -careerGoal: String
        -declaredInterests: Set~String~
        +updateInterests(values: Set~String~): void
    }
    class Enterprise {
        -id: UUID
        -name: String
        -verificationStatus: VerificationStatus
        -publishingStatus: PublishingStatus
        +canPublish(): boolean
    }
    class EnterpriseRepresentative {
        -id: UUID
        -membershipStatus: MembershipStatus
        -publishingPermission: boolean
        +canPublish(): boolean
    }
}
namespace Assessment {
    class AssessmentType {
        -id: UUID
        -code: String
        -name: String
    }
    class AssessmentVersion {
        -id: UUID
        -versionNumber: int
        -status: PublicationStatus
        -evaluatorKey: String
        -scoringConfig: JsonNode
        +validatePublication(): boolean
    }
    class AssessmentAttempt {
        -id: UUID
        -status: AttemptStatus
        -startedAt: Instant
        -submittedAt: Instant
        +recordAnswer(questionId: UUID, answer: JsonNode): void
        +submit(): void
    }
    class AssessmentResult {
        -id: UUID
        -resultData: JsonNode
        -interpretation: String
        -calculatedAt: Instant
    }
}
namespace Simulation {
    class Scenario {
        -id: UUID
        -availabilityStatus: ScenarioAvailability
        -currentPublishedVersionId: UUID
        +isAvailable(): boolean
    }
    class ScenarioVersion {
        -id: UUID
        -versionNumber: int
        -status: PublicationStatus
        -title: String
        -targetRole: String
        -learningObjectives: String
        +validatePublication(): boolean
    }
    class SimulationTask {
        -id: UUID
        -title: String
        -workplaceContext: String
        -instructions: String
        -required: boolean
        +validateDeliverables(items: List~SubmittedDeliverable~): boolean
    }
    class TaskDeliverableDefinition {
        -id: UUID
        -name: String
        -format: DeliverableFormat
        -required: boolean
        -validationConfig: JsonNode
        +accepts(value: JsonNode): boolean
    }
    class SimulationEnrollment {
        -id: UUID
        -status: EnrollmentStatus
        -enrolledAt: Instant
        -startedAt: Instant
        +start(): void
        +canComplete(): boolean
    }
    class TaskSubmission {
        -id: UUID
        -status: SubmissionStatus
        -submittedAt: Instant
        +addItem(item: SubmittedDeliverable): void
        +finalizeSubmission(): void
    }
    class SubmittedDeliverable {
        -id: UUID
        -contentText: String
        -contentUrl: URI
        -fileAssetId: UUID
        +hasOnePayload(): boolean
    }
    class ModelAnswer {
        -id: UUID
        -content: String
        -releasePolicy: AnswerReleasePolicy
        +canRevealFor(submission: TaskSubmission): boolean
    }
}
namespace Evidence {
    class SimulationCompletion {
        -id: UUID
        -completedAt: Instant
        -resumeSnippetText: String
        -certificateCode: String
        +hasCertificate(): boolean
    }
    class CareerSkill {
        -id: UUID
        -code: String
        -name: String
    }
}
namespace Controls {
    class AssessmentApplicationService {
        <<control>>
        +completeAttempt(attemptId: UUID): void
    }
    class SimulationApplicationService {
        <<control>>
        +submitTask(enrollmentId: UUID, taskId: UUID): void
        +completeEnrollment(enrollmentId: UUID): void
    }
}
UserAccount "1" -- "0..1" StudentProfile
UserAccount "1" -- "0..1" EnterpriseRepresentative
Enterprise "1" -- "0..*" EnterpriseRepresentative
Enterprise "1" -- "0..*" Scenario
StudentProfile "1" -- "0..*" AssessmentAttempt
AssessmentType "1" *-- "0..*" AssessmentVersion
AssessmentVersion "1" -- "0..*" AssessmentAttempt
AssessmentAttempt "1" -- "0..1" AssessmentResult
Scenario "1" *-- "0..*" ScenarioVersion
ScenarioVersion "1" *-- "0..*" SimulationTask
SimulationTask "1" *-- "0..*" TaskDeliverableDefinition
SimulationTask "1" *-- "0..1" ModelAnswer
StudentProfile "1" -- "0..*" SimulationEnrollment
ScenarioVersion "1" -- "0..*" SimulationEnrollment
SimulationEnrollment "1" *-- "0..*" TaskSubmission
SimulationTask "1" -- "0..*" TaskSubmission
TaskSubmission "1" *-- "0..*" SubmittedDeliverable
TaskDeliverableDefinition "1" -- "0..*" SubmittedDeliverable
SimulationEnrollment "1" -- "0..1" SimulationCompletion
SimulationTask "0..*" -- "0..*" CareerSkill
AssessmentApplicationService ..> AssessmentAttempt
SimulationApplicationService ..> SimulationEnrollment
