# Copy to .env for local overrides. Never commit real credentials.
POSTGRES_DB=career_simulation
POSTGRES_USER=career_sim
POSTGRES_PASSWORD=career_sim_dev
POSTGRES_PORT=5433
BACKEND_PORT=8081
FRONTEND_PORT=3000
GATEWAY_PORT=8080

# Browser-facing API path. Keep /api when using the Nginx gateway.
VITE_API_BASE_URL=/api

# Temporary browser integration mode for localhost only. Keep false in deployed environments.
LOCAL_DEMO_MODE=false
LOCAL_DEMO_EMAIL=student@demo.com

# External AI is optional. Choose exactly one provider. Keep every key backend-only;
# never prefix a secret with VITE_ and never commit a populated .env file.
AI_PROVIDER=disabled

# OpenAI settings (used only when AI_PROVIDER=openai).
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_BASE_URL=https://api.openai.com/v1

# Gemini settings (used only when AI_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Experimental: let Gemini select tools in a separate planning request.
# Keep false for the reliable server-planned, one-generation-call flow.
AI_GEMINI_TOOL_PLANNING_ENABLED=false

AI_TIMEOUT_SECONDS=8
AI_MAX_OUTPUT_TOKENS=300

# Query/document embeddings (requires reviewed published corpus and Gemini key).
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_MINIMUM_SIMILARITY=0.5

# Optional operator-pinned USD/token price snapshots; see docs/deployment/syn-usage-cost.md.
SYN_COST_RATES_JSON=[]

# Optional public learning-source search via Gemini Google grounding. No raw student query is sent.
SYN_WEB_ENABLED=false
# Leave blank/omit to use GEMINI_MODEL; model must support google_search.
# SYN_WEB_MODEL=gemini-3.1-flash-lite
