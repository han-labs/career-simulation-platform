# Copy to .env for local overrides. Never commit real credentials.
POSTGRES_DB=career_simulation
POSTGRES_USER=career_sim
POSTGRES_PASSWORD=career_sim_dev
POSTGRES_PORT=5433
BACKEND_PORT=8081
FRONTEND_PORT=3000
GATEWAY_PORT=8080

# Browser-facing API path. Keep /api when using the Nginx gateway.
VITE_API_BASE_URL=/api

# External AI is optional in the foundation. Never expose this key to Vite.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=8
