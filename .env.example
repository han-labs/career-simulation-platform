# From this checkout's root: .\scripts\Initialize-LocalEnvironment.ps1
# Copies this template only if .env is absent and fills only a missing JWT key.
# Never overwrite an existing .env or commit real credentials.
POSTGRES_DB=career_simulation
POSTGRES_USER=career_sim
POSTGRES_PASSWORD=career_sim_dev
POSTGRES_PORT=5433
BACKEND_PORT=8081
FRONTEND_PORT=3000
GATEWAY_PORT=8080

# Browser-facing API path. Keep /api when using the Nginx gateway.
VITE_API_BASE_URL=/api

# Standard Compose is local development (loopback-only Admin using an existing ACTIVE account).
# Non-local environments must explicitly select prod or production; no local principal there.
SPRING_PROFILES_ACTIVE=local

# External AI is optional. Choose exactly one provider. Keep every key backend-only;
# never prefix a secret with VITE_ and never commit a populated .env file.
AI_PROVIDER=disabled

# OpenAI settings (used only when AI_PROVIDER=openai).
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_BASE_URL=https://api.openai.com/v1

# Gemini settings (used only when AI_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Experimental: let Gemini select tools in a separate planning request.
# Keep false for the reliable server-planned, one-generation-call flow.
AI_GEMINI_TOOL_PLANNING_ENABLED=false

AI_TIMEOUT_SECONDS=8
AI_MAX_OUTPUT_TOKENS=300

# Query/document embeddings (requires reviewed published corpus and Gemini key).
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_MINIMUM_SIMILARITY=0.5

# Optional operator-pinned USD/token price snapshots; see docs/deployment/syn-usage-cost.md.
SYN_COST_RATES_JSON=[]

# Optional public learning-source search via Gemini Google grounding. No raw student query is sent.
SYN_WEB_ENABLED=false
# Leave blank/omit to use GEMINI_MODEL; model must support google_search.
# SYN_WEB_MODEL=gemini-3.1-flash-lite
# Package A rollout stays off until reviewed content and coordinated cutover.
CORE_V2_ENABLED=true
VITE_CORE_V2_ENABLED=true
LEGACY_WRITE_ENABLED=false
SESSION_COOKIE_SECURE=true

# REQUIRED for Compose: base64 of at least 32 cryptographically random bytes.
# Initialize-LocalEnvironment.ps1 generates a stable key locally, without printing it.
# Keep that key across restarts; changing it invalidates existing JWT sessions.
# Production: inject a key from secret storage. Never use a shared example key.
JWT_SIGNING_KEY=
JWT_ALLOW_EPHEMERAL_KEY=false
JWT_LIFETIME_SECONDS=900
AGENT_PLATFORM_ENABLED=true
VITE_AGENT_PLATFORM_ENABLED=true
GOOGLE_OAUTH_ENABLED=false
# To enable Google, set true and fill BOTH values below in ignored .env only.
# Google credentials do not replace the independent required JWT signing key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Google Cloud Web application callback (no trailing slash).
# localhost gateway: http://localhost:8080/api/login/oauth2/code/google
# Production: https://your-host/api/login/oauth2/code/google
# Local isolated gateway: http://127.0.0.1:18080/api/login/oauth2/code/google
# Setup, canonical origin, Google Cloud test users: docs/testing/google-identity.md
GOOGLE_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/google
# Set false only for an explicitly local HTTP rehearsal; production uses HTTPS.
# PRIVATE_STORAGE_ROOT is a private writable directory outside public static assets.
# Deployment roles are provisioned separately: APP_DB_USERNAME / APP_DB_PASSWORD
# for DML-only runtime; FLYWAY_DB_USERNAME / FLYWAY_DB_PASSWORD for schema owner.
# Local development fallbacks do not provision production roles or credentials.
